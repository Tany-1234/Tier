#include <stdio.h>
int main() {
    int arr[] = {5,4,3,2,1};
    int n = 5;
    int k = 2;

    int multiple = k;
    int found;
    while(1) {
        found = 0;
        for(int i = 0; i < n; i++) {
            if(arr[i] == multiple) {
                found = 1;
                break;
            }
        }
        if(found == 0) {
            printf("Minimum missing multiple = %d", multiple);
            break;
        }
        multiple += k;
    }
    return 0;
}
