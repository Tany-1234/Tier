#include<stdio.h>
int main() {
    int n,m;
    printf("Rows and columns:");
    scanf("%d %d",&n,&m);
    int arr[n][m];
    for(int i=0;i<n;i++) {
        for(int j=0;j<m;j++) {
            printf("Enter value of arr[%d][%d]: ",i,j);
            scanf("%d",&arr[i][j]);
        }
    }
    printf("Matrix print\n");
    for(int i=0;i<n;i++) {
        for(int j=0;j<m;j++) {
            printf("%d ",arr[i][j]);
        }
        printf("\n");
    }
    int i=0;
    int j=n-1;
    int count=0;

    while (i<m && j>=0) {
        if (arr[i][j] < 0) {
            count += (m - i);
            j--;
        } else {
            i++;
        }
    }

    printf("Total negative numbers = %d", count);
    return 0;
}
