#include <stdio.h>

int main()
{
    int low, high, i;

    printf("Enter low and high range: ");
    scanf("%d %d", &low, &high);

    for(i = low; i <= high; i++)
    {
        int num = i;
        int digit[10] = {0};
        int d, distinct = 1;

        while(num > 0)
        {
            d = num % 10;

            if(digit[d] == 1)
            {
                distinct = 0;
                break;
            }

            digit[d] = 1;
            num = num / 10;
        }

        if(distinct)
            printf("%d ", i);
    }

    return 0;
}
