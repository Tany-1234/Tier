#include <stdio.h>

int main() {
    float arr[] = {2, 3, 5, 6,9,1};
    int n = 6;

    printf("Even Sum Pairs:\n");

    for(int i = 0; i < n; i++) {
        if((int)arr[i] != arr[i])
            continue;

        for(int j = i + 1; j < n; j++) {
            if((int)arr[j] != arr[j])
                continue;

            int a = (int)arr[i];
            int b = (int)arr[j];

            if((a + b) % 2 == 0) {
                printf("(%d, %d)\n", a, b);
            }
        }
    }
    return 0;
}
