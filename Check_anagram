#include <stdio.h>

    int main() {
        char str1[100], str2[100];
        int freq[26] = {0};
        int i = 0;

        printf("Enter first string: ");
        scanf("%s", str1);

        printf("Enter second string: ");
        scanf("%s", str2);

        while(str1[i] != '\0') {
            freq[str1[i] - 'a']++;
            i++;
        }
        i = 0;
        while(str2[i] != '\0') {
            freq[str2[i] - 'a']--;
            i++;
        }
        for(i = 0; i < 26; i++) {
            if(freq[i] != 0) {
                printf("Not Anagram");
                return 0;
            }
        }
        printf("Anagram");
        return 0;
    }


