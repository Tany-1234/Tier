#include <stdio.h>
int main() {
    char str[100];
    int i, valid = 1;
    printf("Enter a string: ");
    scanf("%s", str);
    for(i = 0; str[i] != '\0'; i++) {
        if(str[i] != '*' && str[i] != '#') {
            valid = 0;
            break;
        }
    }
    if(valid)
        printf("Valid string\n");
    else
        printf("Invalid string\n");
    return 0;
}
