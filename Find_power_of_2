#include<stdio.h>
int main() {
    int n,i;
    printf("Enter the size ");
    scanf("%d",&n);

    int arr[n];
    printf("Enter the array element ");
    for(i=0;i<n;i++)
        scanf("%d",&arr[i]);

    int count=0;
    printf("Power of 2 elements are:\n");
    for(i = 0; i < n; i++) {

        if ((arr[i] & (arr[i]-1))==0) {
            printf("%d ",arr[i]);
            count+=1;
        }
    }

    printf("\nTotal count = %d", count);

    return 0;
}
