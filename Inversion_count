#include <stdio.h>

int main() {
    int arr[] = {2, 4, 5, 3, 1};
    int n = 5;
    int count = 0;

    for(int i = 0; i < n - 1; i++) {
        for(int j = i + 1; j < n; j++) {
            if(arr[i] > arr[j]) {
                printf("(%d %d)\n",arr[i],arr[j]);
                count++;
            }
        }
    }

    printf("Inversion count = %d", count);

    return 0;
}
