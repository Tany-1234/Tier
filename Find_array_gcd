#include<stdio.h>
int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}
int main() {
    int n;
    printf("enter array size: ");
    scanf("%d",&n);
    int a[n];
    printf("enter array elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d",&a[i]);
    }
    int result=a[0];
    for (int i=1;i<n;i++) {
        result=gcd(result,a[i]);
    }
    printf("GCD of array = %d",result);
    return 0;
    }
