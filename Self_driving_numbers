#include<stdio.h>
int main() {
    int start, end,i,n,d;

    printf("Enter start range: ");
    scanf("%d", &start);

    printf("Enter end range: ");
    scanf("%d", &end);

    for(i = start; i <= end; i++) {
        n = i;
        while(n > 0) {
            d = n % 10;

            if(d == 0 || i % d != 0)
                break;

            n = n / 10;
        }

        if(n == 0)
            printf("%d ", i);
    }

    return 0;
}
