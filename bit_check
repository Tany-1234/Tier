#include <stdio.h>

int main() {
    int n;
    printf("Enter size: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter elements: ");
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int i = 0;

    while(i < n - 1) {
        if(arr[i] == 1)
            i += 2;
        else
            i += 1;
    }

    if(i == n - 1)
        printf("single");
    else
        printf("DOUBLE BIT");

    return 0;
}
